# Telegram Bot token from BotFather. Do not commit a real token.
BOT_TOKEN=123456:ABCDEF_FAKE_TOKEN_REPLACE_ME

# Telegram admin group id. Usually negative, for example -1001234567890.
ADMIN_CHAT_ID=-1000000000000

# Local PostgreSQL database for development.
DATABASE_URL=postgresql://bot_new:bot_new@127.0.0.1:5432/bot_new

DEFAULT_LANGUAGE=ru
DEFAULT_TZ=Europe/Belgrade
LOG_LEVEL=INFO
